<?xml version="1.0" encoding="utf-8"?>
<!-- Jalon con agarre neutro: sentado, manos juntas en un mango en V, codos pegados al cuerpo. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- asiento y muslo -->
    <path
        android:pathData="M16,37 L18,35 L28,33"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- tronco -->
    <path
        android:pathData="M18,35 L18,22"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- cabeza -->
    <path
        android:pathData="M18,18 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- polea alta -->
    <path
        android:pathData="M22,7 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2" />
    <!-- cable hasta el mango -->
    <path
        android:pathData="M22,9 L21,15"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
    <!-- mango en V estrecho, manos juntas -->
    <path
        android:pathData="M18,15 L21,18 L24,15"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- brazos con codos pegados al cuerpo -->
    <path
        android:pathData="M19,22 L15,20 L20,18"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
