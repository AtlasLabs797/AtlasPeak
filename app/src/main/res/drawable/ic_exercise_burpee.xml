<?xml version="1.0" encoding="utf-8"?>
<!-- Burpee: salto explosivo con la figura en el aire, brazos rectos sobre la cabeza, rodillas ligeramente recogidas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- suelo -->
    <path
        android:pathData="M6,43 L42,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- cabeza -->
    <path
        android:pathData="M24,12 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- tronco y piernas recogidas hacia el pecho, en el aire -->
    <path
        android:pathData="M24,14 L24,23 L18,21 L20,27"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- brazos rectos sobre la cabeza -->
    <path
        android:pathData="M24,14 L21,6 M24,14 L27,6"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- lineas de movimiento bajo los pies -->
    <path
        android:pathData="M14,38 L19,38 M23,38 L28,38"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.6"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
</vector>
