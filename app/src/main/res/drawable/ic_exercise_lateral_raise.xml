<?xml version="1.0" encoding="utf-8"?>
<!-- Elevaciones laterales: vista frontal, brazos rectos a los lados en forma de T con mancuernas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- suelo -->
    <path
        android:pathData="M6,43 L42,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- cabeza -->
    <path
        android:pathData="M24,9.5 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- tronco -->
    <path
        android:pathData="M24,13 L24,30"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- piernas -->
    <path
        android:pathData="M24,30 L19,42 M24,30 L29,42"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- brazos en T a la altura de los hombros -->
    <path
        android:pathData="M9,17 L24,15 L39,17"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- mancuernas en las manos -->
    <path
        android:pathData="M9,14.5 L9,19.5 M39,14.5 L39,19.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
    <!-- indicador de elevacion -->
    <path
        android:pathData="M9,12 Q6,10 8,7"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.6"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
</vector>
