<?xml version="1.0" encoding="utf-8"?>
<!-- Elevacion de talones: de pie sobre las puntas de los pies en el borde de un escalon, talones en el aire. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- cabeza -->
    <path
        android:pathData="M20,10 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- tronco y pierna recta -->
    <path
        android:pathData="M20,14 L20,37"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- pie en punta sobre el escalon y talon colgando -->
    <path
        android:pathData="M20,37 L24,38 M20,37 L18,40"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- brazo al costado -->
    <path
        android:pathData="M20,15 L17,20"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- borde del escalon -->
    <path
        android:pathData="M12,38 L44,38 M12,38 L12,44"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- flecha de subida -->
    <path
        android:pathData="M40,21 L40,14 M38,16 L40,14 L42,16"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.6"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
