<?xml version="1.0" encoding="utf-8"?>
<!-- Elevacion de talones: de pie totalmente vertical, en puntas sobre el borde de un escalon, talon elevado. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- cabeza -->
    <path
        android:pathData="M20,9 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- tronco y pierna, completamente rectos -->
    <path
        android:pathData="M20,13 L20,36"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- pie en punta sobre el escalon y talon elevado detras -->
    <path
        android:pathData="M20,36 L26,38 M20,36 L17,34"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- brazo recto al costado -->
    <path
        android:pathData="M20,15 L18,23"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- borde del escalon -->
    <path
        android:pathData="M13,38 L27,38 L27,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- flecha de subida junto al talon -->
    <path
        android:pathData="M12,30 L12,22 M10,25 L12,22 L14,25"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.6"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
