<?xml version="1.0" encoding="utf-8"?>
<!-- Curl con barra: vista frontal, codos pegados al cuerpo, ambos antebrazos suben una barra larga al pecho (no a la cabeza). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- suelo -->
    <path
        android:pathData="M6,43 L42,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- cabeza -->
    <path
        android:pathData="M24,9.5 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- tronco -->
    <path
        android:pathData="M24,13 L24,29"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- dos piernas, vista frontal -->
    <path
        android:pathData="M24,29 L20,42 M24,29 L28,42"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- brazos: superiores fijos al costado, antebrazos suben la barra al pecho -->
    <path
        android:pathData="M22,17 L21,26 L21,20 M26,17 L27,26 L27,20"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- barra larga a la altura del pecho -->
    <path
        android:pathData="M14,20 L34,20"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- discos -->
    <path
        android:pathData="M16,17 L16,23 M32,17 L32,23"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
</vector>
