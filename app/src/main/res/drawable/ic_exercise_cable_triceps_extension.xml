<?xml version="1.0" encoding="utf-8"?>
<!-- Extension de triceps por encima de la cabeza: torso inclinado, brazo arriba junto a la cabeza, cuerda a polea baja detras. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- suelo -->
    <path
        android:pathData="M6,43 L42,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- cabeza -->
    <path
        android:pathData="M26,10 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- tronco inclinado y pierna -->
    <path
        android:pathData="M25,13 L22,28 L20,42"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- brazo: superior arriba junto a la cabeza, antebrazo al frente sosteniendo la cuerda -->
    <path
        android:pathData="M24,16 L25,8 L34,6"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- extremos de la cuerda -->
    <path
        android:pathData="M33,4 L33,8 M36,4 L36,8"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- polea baja -->
    <path
        android:pathData="M8,41 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2" />
    <!-- cable desde la polea baja y detras hasta la cuerda -->
    <path
        android:pathData="M9,39 L34,6"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.6"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
</vector>
