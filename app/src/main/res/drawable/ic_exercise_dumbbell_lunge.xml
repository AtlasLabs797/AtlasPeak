<?xml version="1.0" encoding="utf-8"?>
<!-- Zancada con mancuernas: misma zancada al frente, brazo recto abajo con una mancuerna visible en la mano. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- suelo -->
    <path
        android:pathData="M6,43 L42,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- cabeza -->
    <path
        android:pathData="M20,10 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- tronco vertical -->
    <path
        android:pathData="M20,14 L20,24"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- pierna delantera (rodilla 90) y pierna trasera (rodilla cerca del suelo) -->
    <path
        android:pathData="M20,24 L28,25 L28,37 L33,37 M20,24 L13,39 L8,41"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- brazo recto hacia abajo -->
    <path
        android:pathData="M20,15 L19,28"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- mancuerna perpendicular al brazo -->
    <path
        android:pathData="M15,28 L23,28 M15,25 L15,31 M23,25 L23,31"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />
</vector>
