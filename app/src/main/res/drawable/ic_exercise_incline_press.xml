<?xml version="1.0" encoding="utf-8"?>
<!-- Press inclinado: tumbado a lo largo del respaldo diagonal, brazo empuja la barra recta hacia arriba. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- suelo -->
    <path
        android:pathData="M6,43 L42,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- banco: respaldo diagonal, asiento y pata -->
    <path
        android:pathData="M10,41 L26,27 M10,41 L20,41 M14,41 L14,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- cabeza en el extremo alto del respaldo -->
    <path
        android:pathData="M30,24 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- tronco tumbado a lo largo del respaldo -->
    <path
        android:pathData="M28,27 L14,40"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- muslo y pierna al suelo -->
    <path
        android:pathData="M14,40 L20,41 L19,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- brazo recto vertical empujando -->
    <path
        android:pathData="M23,32 L23,14"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- barra -->
    <path
        android:pathData="M15,14 L31,14"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- discos -->
    <path
        android:pathData="M17,11 L17,17 M29,11 L29,17"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
</vector>
