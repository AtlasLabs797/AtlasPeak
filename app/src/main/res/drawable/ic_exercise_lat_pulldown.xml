<?xml version="1.0" encoding="utf-8"?>
<!-- Jalon al pecho: sentado, codos suben cerca de la cabeza y giran hacia afuera hasta los extremos de una barra ancha. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- suelo -->
    <path
        android:pathData="M6,43 L42,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- asiento, muslo y pierna al suelo -->
    <path
        android:pathData="M12,36 L16,36 L27,35 L29,42"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- cabeza -->
    <path
        android:pathData="M16,19 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- tronco vertical -->
    <path
        android:pathData="M16,36 L16,23"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- brazos: suben junto a la cabeza y giran hacia los extremos de la barra -->
    <path
        android:pathData="M16,25 L13,13 L6,12 M16,25 L19,13 L30,12"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- barra ancha -->
    <path
        android:pathData="M6,12 L30,12"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- cable corto hasta la polea, desplazado del eje de la cabeza -->
    <path
        android:pathData="M22,12 L25,7"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
    <!-- polea alta -->
    <path
        android:pathData="M26,6 m-1.8,0 a1.8,1.8 0 1,1 3.6,0 a1.8,1.8 0 1,1 -3.6,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2" />
</vector>
