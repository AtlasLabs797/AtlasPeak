<?xml version="1.0" encoding="utf-8"?>
<!-- Extension de triceps en polea: codos fijos al costado, empuja una barra recta hacia abajo. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- suelo -->
    <path
        android:pathData="M6,43 L42,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- cabeza -->
    <path
        android:pathData="M23,9.5 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- tronco y pierna -->
    <path
        android:pathData="M23,13 L23,29 L21,42"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- brazo: superior fijo, antebrazo empuja hacia abajo -->
    <path
        android:pathData="M23,16 L23,24 L28,31"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- barra recta -->
    <path
        android:pathData="M24,31 L32,31"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- cable hacia la polea -->
    <path
        android:pathData="M33,12 L32,31"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
    <!-- polea alta -->
    <path
        android:pathData="M33,10 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2" />
</vector>
