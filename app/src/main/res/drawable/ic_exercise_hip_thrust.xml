<?xml version="1.0" encoding="utf-8"?>
<!-- Hip thrust: espalda alta apoyada en el banco, linea recta de hombro a rodilla, espinillas verticales, barra sobre la cadera. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- suelo -->
    <path
        android:pathData="M6,43 L42,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- banco: superficie y pata -->
    <path
        android:pathData="M8,20 L15,20 M11,20 L11,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- cabeza apoyada en el banco -->
    <path
        android:pathData="M9,16 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- linea recta hombro-cadera-rodilla -->
    <path
        android:pathData="M11,19 L23,25 L35,31"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- espinilla vertical y pie en el suelo -->
    <path
        android:pathData="M35,31 L35,42 L40,42"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- barra vertical sobre la cadera -->
    <path
        android:pathData="M23,20 L23,30"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- discos -->
    <path
        android:pathData="M20,20 L26,20 M20,30 L26,30"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
</vector>
