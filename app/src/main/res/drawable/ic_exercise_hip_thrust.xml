<?xml version="1.0" encoding="utf-8"?>
<!-- Hip thrust: espalda alta apoyada en el banco, cadera elevada en linea recta con el torso y los muslos, barra sobre la cadera. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- suelo -->
    <path
        android:pathData="M6,43 L42,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- cabeza -->
    <path
        android:pathData="M8,15 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- banco (superficie y soporte) -->
    <path
        android:pathData="M8,19 L16,19 M12,19 L12,41"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- tronco, cadera elevada, muslo, pierna y pie -->
    <path
        android:pathData="M12,18 L24,24 L36,30 L36,41 L41,41"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- brazo hacia la barra -->
    <path
        android:pathData="M12,18 L24,21"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- barra sobre la cadera -->
    <path
        android:pathData="M24,20 L24,28"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- discos -->
    <path
        android:pathData="M21,20 L27,20 M21,28 L27,28"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
</vector>
