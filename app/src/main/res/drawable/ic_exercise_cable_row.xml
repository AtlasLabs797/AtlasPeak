<?xml version="1.0" encoding="utf-8"?>
<!-- Remo en polea baja: sentado con piernas extendidas, tirando de la maneja hacia el vientre. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- suelo -->
    <path
        android:pathData="M6,43 L42,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- piernas extendidas hacia adelante -->
    <path
        android:pathData="M20,36 L34,36"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- tronco vertical -->
    <path
        android:pathData="M20,36 L19,22"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- cabeza -->
    <path
        android:pathData="M18,18 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- brazo tirando: codo flexionado hacia atras hasta el vientre -->
    <path
        android:pathData="M19,22 L14,26 L20,28"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- polea baja frente a los pies -->
    <path
        android:pathData="M37,29 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2" />
    <!-- cable horizontal -->
    <path
        android:pathData="M35,29 L21,28"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />
</vector>
