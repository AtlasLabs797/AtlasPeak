<?xml version="1.0" encoding="utf-8"?>
<!-- Rueda abdominal: de rodillas en el suelo, torso casi horizontal estirado al frente, brazos hacia la rueda. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- suelo -->
    <path
        android:pathData="M6,43 L42,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- cabeza -->
    <path
        android:pathData="M36,15 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- tronco casi horizontal -->
    <path
        android:pathData="M34,17 L18,24"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- muslo angulado y rodilla en el suelo -->
    <path
        android:pathData="M18,24 L14,42 L9,42"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- brazo recto hacia la rueda -->
    <path
        android:pathData="M34,18 L41,39"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- rueda -->
    <path
        android:pathData="M41,41 m-3,0 a3,3 0 1,1 6,0 a3,3 0 1,1 -6,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2" />
</vector>
