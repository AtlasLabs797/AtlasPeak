<?xml version="1.0" encoding="utf-8"?>
<!-- Rueda abdominal: de rodillas, brazos extendidos al frente sosteniendo la rueda en el suelo, torso estirado. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- suelo -->
    <path
        android:pathData="M6,43 L42,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- cabeza -->
    <path
        android:pathData="M34,13 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- tronco estirado hacia adelante -->
    <path
        android:pathData="M32,16 L20,28"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- pierna de rodillas -->
    <path
        android:pathData="M20,28 L20,42 L13,42"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- brazo hacia la rueda -->
    <path
        android:pathData="M32,17 L41,37"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- rueda -->
    <path
        android:pathData="M41,40 m-3,0 a3,3 0 1,1 6,0 a3,3 0 1,1 -6,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2" />
</vector>
