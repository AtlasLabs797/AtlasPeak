<?xml version="1.0" encoding="utf-8"?>
<!-- Press banca: tumbado horizontal en banco plano, un brazo vertical empuja la barra arriba del pecho. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="48"
    android:viewportHeight="48">
    <!-- suelo -->
    <path
        android:pathData="M6,43 L42,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeAlpha="0.45"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- banco: superficie y patas -->
    <path
        android:pathData="M8,31 L30,31 M10,31 L10,38 M28,31 L28,38"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- cabeza -->
    <path
        android:pathData="M10,26 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFFFF" />
    <!-- tronco horizontal sobre el banco -->
    <path
        android:pathData="M10,29.5 L26,29.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- muslo doblado y pierna al suelo -->
    <path
        android:pathData="M26,29.5 L31,25 L34,42"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- brazo vertical hacia la barra -->
    <path
        android:pathData="M14,29.5 L14,12"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- barra -->
    <path
        android:pathData="M6,12 L22,12"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
    <!-- discos -->
    <path
        android:pathData="M8,9 L8,15 M20,9 L20,15"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round" />
</vector>
