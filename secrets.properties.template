# secrets.properties.template
#
# Copia este archivo a `secrets.properties` (que está gitignored) y rellena los valores.
# NUNCA subas secrets.properties al repositorio. Ver SECURITY.md SEC-004/005.
#
#   cp secrets.properties.template secrets.properties
#
# 1) OAuth 2.0 Client ID tipo "Web application" (Google Cloud Console > Credenciales).
#    Lo usa Credential Manager (Google Identity) y el flujo OAuth de Drive.
OAUTH_WEB_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com

# 2) API key de Maps SDK for Android. Restríngela por package name + SHA-1 en Cloud Console.
MAPS_API_KEY=TU_MAPS_API_KEY
